{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Python app repos, on top of default.json5. Its review rules (majors,
  // 0.x minors) don't overlap the automerge rules here.
  // A constraints.txt is a full frozen set, so it is a pip_requirements
  // file too (requirements*.txt is matched by default); a package in both
  // moves in one PR. pip_requirements has no lock file maintenance.
  pip_requirements: {
    managerFilePatterns: ["/(^|/)[\\w-]*requirements([-.]\\w+)?\\.txt$/", "/(^|/)constraints\\.txt$/"],
  },
  packageRules: [
    // ------------------------------------------------------- labels, commits
    // tnwks-ops' labels.json5 and semanticCommits.json5 have no Python rules.
    {
      matchDatasources: ["pypi"],
      addLabels: ["renovate/python"],
    },
    {
      matchDatasources: ["pypi"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(python)!: ",
    },
    {
      matchDatasources: ["pypi"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "python",
    },
    {
      matchDatasources: ["pypi"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "python",
    },
    // ------------------------------------------------------------- automerge
    {
      description: "Python packages and the base image: patch and digest",
      matchManagers: ["pip_requirements", "pep621", "dockerfile"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      // 0.x minors can break at any time (zer0ver), so they stay manual.
      description: "Python packages: minor, outside 0.x",
      matchManagers: ["pip_requirements", "pep621"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
    },
    {
      // A new Python minor changes which wheels exist and the runtime the
      // app sees.
      description: "Python image minors: always reviewed",
      matchDatasources: ["docker"],
      matchPackageNames: ["python"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
  ],
}
